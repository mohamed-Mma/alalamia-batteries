rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // المنتجات: القراءة متاحة للجميع، الكتابة للمستخدمين المسجلين فقط
    // ملاحظة أمنية: قبل الإطلاق العام، قيّد الكتابة بحسابات الإدارة فقط
    // باستخدام custom claims أو قائمة UID موثوقة في القاعدة
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // إعدادات الموقع (أرقام التواصل، روابط...) - قراءة عامة، كتابة للمصرح
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // أي مجموعة أخرى ممنوعة افتراضياً
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
